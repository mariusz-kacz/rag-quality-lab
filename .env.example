# Copy this file to .env.local for local live-service testing, then run commands as:
# raglab --env-file .env.local corpus ingest --collection rag_quality_lab --recreate
#
# Azure AI Foundry project OpenAI-compatible endpoint
# If Foundry shows a URL ending in /responses, remove that suffix here.
# When FOUNDRY_API_KEY is empty, the app uses Entra ID via DefaultAzureCredential.
FOUNDRY_OPENAI_BASE_URL=https://your-project.services.ai.azure.com/api/projects/your-project/openai/v1
FOUNDRY_API_KEY=
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small
FOUNDRY_CHAT_MODEL=gpt-4o-mini
# Optional. For Azure GPT-5.1 deployments, use none to disable reasoning.
FOUNDRY_REASONING_EFFORT=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
RAGLAB_QDRANT_COLLECTION=rag_quality_lab

# Runtime tuning
# Shared by query and eval run. Explicit command options override these values.
RAGLAB_TOP_K=5
RAGLAB_MAX_CONTEXT_TOKENS=1000
RAGLAB_OUTPUT_TOKEN_LIMIT=500
# Optional local reranking: install with uv sync --locked --extra rerank.
# --rerank enables it for either query or eval run; --no-rerank keeps the control.
RAGLAB_RERANK_ENABLED=false
RAGLAB_CANDIDATE_K=20
RAGLAB_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Routed retrieval includes categories within this score margin of the winning route.
RAGLAB_ROUTER_CATEGORY_MARGIN=0.15

# Ragas evaluation (install with uv sync --locked --extra eval)
# Set the judge deployment explicitly; evaluation needs no embedding deployment.
RAGLAB_EVAL_MODEL=
# Blank endpoint/key reuse Foundry configuration and its API-key/Entra authentication.
# A different endpoint requires its own RAGLAB_EVAL_API_KEY.
RAGLAB_EVAL_BASE_URL=
RAGLAB_EVAL_API_KEY=
RAGLAB_EVAL_TIMEOUT_SECONDS=120
RAGLAB_EVAL_MAX_RETRIES=1
